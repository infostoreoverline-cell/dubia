# Variabili d'ambiente — BioTwin Sensor API
# Copia questo file in .env.local per sviluppo locale.
# Su Vercel: imposta queste variabili nel pannello Project Settings → Environment Variables.

# ── Google Sheets ─────────────────────────────────────────────────────────────
# ID del tuo Google Spreadsheet (dalla URL: /spreadsheets/d/QUESTO_ID/edit)
SHEET_ID=your_spreadsheet_id_here

# Credenziali del Service Account Google (JSON stringificato su una sola riga)
# Ottieni il file credentials.json da Google Cloud Console → Service Accounts
# Poi converti con: node -e "console.log(JSON.stringify(require('./credentials.json')))"
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
